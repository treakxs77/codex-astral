+{
+  "Descriptions": {
+    "uL-Vias.taco": {
+      "Source": "uL Vias focuses on clear, efficient routes for speed leveling, quality‑of‑life additions, and high‑value farms. It’s actively maintained and will keep expanding with new paths, farms, and quality‑of‑life tweaks that the community find fun or genuinely useful.",
+      "French": "uL Vias propose des itinéraires clairs et efficaces pour progresser rapidement en niveaux, améliorer le confort de jeu et suivre des circuits de récolte rentables. Le pack est régulièrement entretenu et s’enrichit de parcours et d’améliorations utiles à la communauté."
+    },
+    "fast_TacO_pack.taco": {
+      "Source": "A set of markers and trails for some of the most profitable solo-farming gathering routes across a wide range of maps.\r\nClick the Info button for current benchmarks and more details!",
+      "French": "Des marqueurs et parcours pour certains des circuits de récolte en solo les plus rentables, sur de nombreuses cartes.\nCliquez sur Informations pour consulter les mesures de rentabilité et les détails à jour."
+    },
+    "FvD_Dungeon_Guide.taco": {
+      "Source": "Trails for all dungeon explorable and story paths (excluding Arah Story mode). Includes: Path info, mechanics, and some skips.",
+      "French": "Parcours pour tous les chemins d’exploration et modes Histoire des donjons, sauf le mode Histoire d’Arah. Comprend des informations sur les chemins, les mécaniques et certains raccourcis."
+    },
+    "moar.taco": {
+      "Source": "The MOAR Marker Pack aims to help players run efficient open world metas and Hero Point trains.",
+      "French": "Le pack MOAR aide les joueurs à organiser efficacement les méta-événements en monde ouvert et les parcours de points de héros."
+    },
+    "RACE_BeetleTracks.taco": {
+      "Source": "A selection of tracks created and curated by the members of [RACE].\n\n[RACE] Discord Link: https://discord.gg/wkJbRwA",
+      "French": "Une sélection de circuits créés et sélectionnés par les membres de [RACE].\n\nDiscord de [RACE] : https://discord.gg/wkJbRwA"
+    },
+    "abaddon.taco": {
+      "Source": "EoD and LW1 set of markers to make achievement chasers' life easier, also has some QoL markers for EoD",
+      "French": "Des marqueurs pour End of Dragons et la saison 1 du Monde vivant, afin de faciliter la chasse aux succès. Comprend aussi des marqueurs pratiques pour End of Dragons."
+    },
+    "Aixxel_HP.zip": {
+      "Source": "This pack contains guides for Aixxel's Chill and Fast HP trains. Includes Heart of Thorns, Path of Fire, End of Dragon's and Vision's of Eternity. Chill routes grab all the waypoints as well while fast focuses on HP and only the waypoints needed for the run. Also shows Comm port enter and exit locations.",
+      "French": "Guides des parcours de points de héros d’Aixxel, en version tranquille ou rapide, pour Heart of Thorns, Path of Fire, End of Dragons et Visions of Eternity. Les parcours tranquilles passent par tous les points de passage ; les rapides privilégient les points de héros et les seuls points de passage nécessaires. Les entrées et sorties des portails du commandant sont également indiquées."
+    },
+    "apo_markers.taco": {
+      "Source": "This pack aims to provide guidance for the Kela Raid Encounter. It displays the positions of the Executor of Waves spawns (numbered), the area of in which waves trigger depending on Kelas position in the arena, and a spot from which you can comfortably reach all Executor of Waves spawns with 1500 range.",
+      "French": "Guide du combat de raid contre Kela : positions numérotées d’apparition des exécuteurs des vagues, zones de déclenchement des vagues selon la position de Kela dans l’arène et emplacement permettant d’atteindre toutes les apparitions avec une portée de 1 500."
+    },
+    "Aurizara_HP.taco": {
+      "Source": "Detailed paths and markers for portals, hazards and instructions for running on and hosting HP Trains in all three expansions.",
+      "French": "Parcours détaillés et marqueurs pour les portails, les dangers et les consignes, afin de suivre ou de diriger des parcours de points de héros dans Heart of Thorns, Path of Fire et End of Dragons."
+    },
+    "AutomaticArrows.taco": {
+      "Source": "Struggling to find markers that have no trail? Tired of having to backtrack after a marker you just missed?\nLook no further! Automatic Arrows is a helper script that can work with any other marker pack. It automatically generates arrows that point to the markers closest to you. Requires Lua Scripts to be turned on in Pathing settings.",
+      "French": "Vous avez du mal à trouver les marqueurs sans parcours, ou vous devez revenir sur vos pas après en avoir manqué un ? Automatic Arrows fonctionne avec les autres packs et génère automatiquement des flèches vers les marqueurs les plus proches. Nécessite d’activer les scripts Lua dans les paramètres de Pathing."
+    },
+    "ConvergenceCorpTrails.taco": {
+      "Source": "A Marker/Pathing pack for Convergences!\nIncludes pathing for private Convergences (public soon) and some JW hearts.\nhttps://convergencecorp.net/",
+      "French": "Un pack de marqueurs et de parcours pour les convergences !\nComprend les convergences privées, les publiques étant annoncées pour plus tard, ainsi que certains cœurs de Janthir Wilds.\nhttps://convergencecorp.net/"
+    },
+    "Czokalapik-s-Guides-for-GW2Taco.taco": {
+      "Source": "This marker pack is designed for Commanders leading HP trains and/or solo players (with small requirements). Very few challenges require Springer, original routes requiring only HoT masteries and/or gliding are not included for some Hero Challenges (for example Glided River).",
+      "French": "Pack conçu pour les commandants qui dirigent des parcours de points de héros et pour les joueurs en solo, avec quelques prérequis. Très peu de défis demandent le frappesol. Pour certains défis de héros, les itinéraires d’origine ne demandant que les maîtrises de Heart of Thorns ou le deltaplane ne sont pas inclus, par exemple Glided River."
+    },
+    "kreskysmarkers.zip": {
+      "Source": "Currently only contains a Hero Point train for Heart of Thorns (Verdant Brink, Auric Basin and Tangled Depths).\r\nThe path is designed with the idea that anyone could follow as long as they have the Gliding Basics mastery (no other masteries needed aside from Itzel Poison Lore for 1 HP in Tangled Depths).",
+      "French": "Contient actuellement un parcours de points de héros pour Heart of Thorns : Orée d’émeraude, Bassin aurique et Profondeurs verdoyantes.\n\nIl est conçu pour être accessible avec la maîtrise de base du deltaplane. Aucune autre maîtrise n’est nécessaire, à l’exception de la connaissance des poisons itzels pour un point de héros des Profondeurs verdoyantes."
+    },
+    "TearTokenPack.taco": {
+      "Source": "A collection of trails for various collections (formerly Tear Token Pack).",
+      "French": "Des parcours pour plusieurs collections, anciennement regroupés sous le nom Tear Token Pack."
+    },
+    "haskha_markers.zip": {
+      "Source": "A collection of markers for raids and strikes.",
+      "French": "Une collection de marqueurs pour les raids et les missions d’attaque."
+    },
+    "HeartZones.taco": {
+      "Source": "Zone outlines shown on your map for each of the hearts in-game.",
+      "French": "Affiche sur la carte les limites des zones correspondant à chaque cœur du jeu."
+    },
+    "hero.blish.pack.zip": {
+      "Source": "This pack provides skip guides, mechanical optimization, encounter strategy support, and general QoL markers for Fractals of the Mists, Raids, Strikes, and Dungeons, in addition to limited build support for SFTA. Individuals who are significantly experienced in end-game PvE content will see little to no use from this pack, and the same goes for brand new players. But if you're someone who doesn't fit in either extreme, then this pack will suit you well.",
+      "French": "Ce pack propose des guides de raccourcis, des conseils pour optimiser les mécaniques et les stratégies de combat, ainsi que des marqueurs pratiques pour les Fractales des Brumes, raids, missions d’attaque et donjons. Il fournit aussi une aide limitée aux configurations SFTA. Il sera peu utile aux joueurs très expérimentés en JcE de haut niveau comme aux débutants complets ; il s’adresse surtout aux joueurs situés entre ces deux niveaux."
+    },
+    "HeroineDark_SAB_Guides.taco": {
+      "Source": "Random guides to help players and enhance experiences with the game.",
+      "French": "Différents guides pour aider les joueurs et enrichir leur expérience de jeu."
+    },
+    "JapyxTrails.taco": {
+      "Source": "This Marker Pack is designed for an easy Home Instance gathering with trails, markers and bandit chest locations.",
+      "French": "Facilite la récolte dans l’instance personnelle grâce à des parcours, des marqueurs et aux emplacements des coffres de bandit."
+    },
+    "KevPack.taco": {
+      "Source": "Marker pack made for farming Magic Mirrors on Castora. Includes key reminders and instructions.",
+      "French": "Un pack pour récolter les miroirs magiques de Castora, avec des rappels pour les clés et des consignes."
+    },
+    "LadyElyssaAP.taco": {
+      "Source": "This pack focuses on Achievements & Collections for the Living World and all Expansions.",
+      "French": "Ce pack se concentre sur les succès et collections du Monde vivant et de toutes les extensions."
+    },
+    "LadyElyssa.taco": {
+      "Source": "A comprehensive marker pack covering Chest Runs, Festivals, Gathering,  Guild Missions, Hero Points (HoT, PoF, EoD), Jumping Puzzles, Key Farming, Map Completion, World Bosses, Living World and more...",
+      "French": "Un pack complet couvrant les circuits de coffres, festivals, récoltes, missions de guilde, points de héros de Heart of Thorns, Path of Fire et End of Dragons, puzzles de saut, récolte de clés, exploration de cartes, boss mondiaux, Monde vivant et bien plus encore."
+    },
