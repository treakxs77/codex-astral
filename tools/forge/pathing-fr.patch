@@ -0,0 +1,15 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace BhModule.Community.Pathing.Utility {
+    // Unknown definitions, repeatables and unavailable account data never count as finished.
+    public static class CompletionPolicy {
+        public static bool AllFinished(IEnumerable<int> ids, ISet<int> known, ISet<int> repeatable,
+                                       Func<int, bool?> completed, bool fresh) {
+            if (!fresh || ids == null) return false;
+            var list = ids.Distinct().ToArray();
+            return list.Length > 0 && list.All(id => known.Contains(id) && !repeatable.Contains(id) && completed(id) == true);
+        }
+    }
+}
--- a/Utility/CompletionUtil.cs
+++ b/Utility/CompletionUtil.cs
@@ -0,0 +1,73 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using BhModule.Community.Pathing.State;
+using Newtonsoft.Json.Linq;
+using TmfLib.Pathable;
+
+namespace BhModule.Community.Pathing.Utility {
+    public static class CompletionUtil {
+        public static readonly HashSet<int> Known = new HashSet<int>();
+        public static readonly HashSet<int> Repeatable = new HashSet<int>();
+
+        static CompletionUtil() {
+            try {
+                using (var stream = Assembly.GetExecutingAssembly().GetManifestResourceStream("CompletionDefinitions.json"))
+                using (var reader = new StreamReader(stream)) {
+                    var data = JObject.Parse(reader.ReadToEnd());
+                    foreach (var id in data["known"].Values<int>()) Known.Add(id);
+                    foreach (var id in data["repeatable"].Values<int>()) Repeatable.Add(id);
+                }
+            } catch { Known.Clear(); Repeatable.Clear(); }
+        }
+
+        public static bool Enabled(PathingCategory category) {
+            for (var current = category; current != null; current = current.Parent) {
+                if (current.ExplicitAttributes.TryGetAttribute("completion-track", out var attr))
+                    return string.Equals(attr.GetValueAsString(), "true", StringComparison.OrdinalIgnoreCase);
+            }
+            return false;
+        }
+
+        private static bool KeepAvailable(PathingCategory category) {
+            for (var current = category; current != null; current = current.Parent) {
+                if (current.ExplicitAttributes.TryGetAttribute("completion-keepavailable", out var attr) &&
+                    string.Equals(attr.GetValueAsString(), "true", StringComparison.OrdinalIgnoreCase)) return true;
+            }
+            return false;
+        }
+
+        private static IEnumerable<int> OwnIds(PathingCategory category) {
+            if (category.ExplicitAttributes.TryGetAttribute("completion-achievements", out var list)) {
+                foreach (var token in list.GetValueAsString().Split(',')) {
+                    if (int.TryParse(token.Trim(), out int id) && id > 0) yield return id;
+                    else yield return -1; // Invalid or incomplete mapping cannot archive a category.
+                }
+            } else if (!category.ExplicitAttributes.TryGetAttribute("achievementbit", out _) &&
+                       category.ExplicitAttributes.TryGetAttribute("achievementid", out var value)) {
+                if (int.TryParse(value.GetValueAsString(), out int id) && id > 0) yield return id;
+            }
+        }
+
+        public static bool IsCompleted(PathingCategory category, IPackState state) {
+            if (category == null || state?.AchievementStates == null || !state.UserConfiguration.PackOrganizeCompletedAchievements.Value || category.IsSeparator || !Enabled(category) || KeepAvailable(category)) return false;
+            var ids = OwnIds(category).ToList();
+            if (ids.Count == 0) return false;
+            // A completed parent must not take an independent repeatable/incomplete child with it.
+            foreach (var child in CategoryUtil.FlattenCategories(category).Skip(1)) {
+                if (KeepAvailable(child)) return false;
+                if (child.ExplicitAttributes.TryGetAttribute("achievementid", out var childAttribute)) {
+                    ids.Add(int.TryParse(childAttribute.GetValueAsString(), out int childId) && childId > 0 ? childId : -1);
+                }
+                ids.AddRange(OwnIds(child));
+            }
+            int revision = state.AchievementStates.CompletionRevision;
+            bool completed = CompletionPolicy.AllFinished(ids, Known, Repeatable,
+                state.AchievementStates.GetCompletedStatus, state.AchievementStates.CompletionDataAvailable);
+            return completed && state.AchievementStates.CompletionDataAvailable &&
+                revision == state.AchievementStates.CompletionRevision;
+        }
+    }
+}
