--- a/MarkerPackRepo/PackLanguage.cs
+++ b/MarkerPackRepo/PackLanguage.cs
@@ -0,0 +1,45 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.IO.Compression;
+using System.Linq;
+using System.Security.Cryptography;
+using Newtonsoft.Json;
+
+namespace BhModule.Community.Pathing.MarkerPackRepo {
+    // Names and download identifiers remain those supplied by the publisher.
+    internal static class PackLanguage {
+        private sealed class Catalogue {
+            public Dictionary<string, string> Downloads { get; set; }
+            public Dictionary<string, string[]> FrenchInstalledHashes { get; set; }
+        }
+
+        private static readonly Catalogue Data = Load();
+
+        private static Catalogue Load() {
+            using (var stream = typeof(PackLanguage).Assembly.GetManifestResourceStream("PackLanguages.json"))
+            using (var reader = new StreamReader(stream)) {
+                return JsonConvert.DeserializeObject<Catalogue>(reader.ReadToEnd());
+            }
+        }
+
+        public static string DownloadLabel(string fileName) {
+            return fileName != null && Data.Downloads.TryGetValue(fileName, out string label)
+                ? label : "Langue à vérifier";
+        }
+
+        public static string InstalledLabel(string fileName, string path) {
+            if (fileName == null || !File.Exists(path)) return null;
+            try { using (var archive = ZipFile.OpenRead(path)) { var entry=archive.GetEntry("_forge-translation.json"); if(entry!=null&&entry.Length<1048576) using(var reader=new StreamReader(entry.Open())) { var metadata=JsonConvert.DeserializeObject<Dictionary<string,object>>(reader.ReadToEnd()); if(metadata.TryGetValue("Language",out var language)&&Convert.ToString(language)=="fr")return "FR"; } } } catch (InvalidDataException) { } catch (IOException) { } catch (JsonException) { }
+            if (!Data.FrenchInstalledHashes.TryGetValue(fileName, out string[] hashes)) return null;
+            try {
+                using (var file = File.OpenRead(path))
+                using (var sha = SHA256.Create()) {
+                    string hash = BitConverter.ToString(sha.ComputeHash(file)).Replace("-", "").ToLowerInvariant();
+                    return hashes.Contains(hash) ? "FR" : null;
+                }
+            } catch (IOException) { return null; }
+            catch (UnauthorizedAccessException) { return null; }
+        }
+    }
+}
--- a/MarkerPackRepo/PackText.cs
