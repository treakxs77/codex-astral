+using System;
+using System.Collections.Generic;
+using System.Linq;
+using BhModule.Community.Pathing.State;
+using Microsoft.Xna.Framework;
+using TmfLib.Pathable;
+
+namespace BhModule.Community.Pathing.UI.Controls.TreeNodes {
+    public class CompletedCategoryNode : LabelNode {
+        private readonly IPackState _state;
+        private readonly List<PathingCategory> _categories;
+        public CompletedCategoryNode(IPackState state, IEnumerable<PathingCategory> categories)
+            : base("Terminés (" + categories.Count() + ")") {
+            _state = state;
+            _categories = categories.ToList();
+            TextColor = Color.LightGreen;
+            ShowIconTooltip = false;
+        }
+        protected override void OnShown(EventArgs e) {
+            ClearChildNodes();
+            foreach (var category in _categories) {
+                _ = new PathingCategoryNode(_state, category, true, true) {
+                    Width = Math.Max(40, Width - 14), Parent = this, Visible = Expanded
+                };
+            }
+            base.OnShown(e);
+        }
+    }
+}
