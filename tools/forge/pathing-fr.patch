@@ -0,0 +1,47 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text.RegularExpressions;
+using Newtonsoft.Json;
+
+namespace BhModule.Community.Pathing.MarkerPackRepo {
+    internal static class PackText {
+        private sealed class Translation {
+            public string Source { get; set; }
+            public string French { get; set; }
+        }
+
+        private sealed class Catalogue {
+            public Dictionary<string, Translation> Descriptions { get; set; }
+            public Dictionary<string, string> Categories { get; set; }
+        }
+
+        private static readonly Catalogue Data = Load();
+
+        private static Catalogue Load() {
+            using (var stream = typeof(PackText).Assembly.GetManifestResourceStream("PackText.fr.json"))
+            using (var reader = new StreamReader(stream)) {
+                return JsonConvert.DeserializeObject<Catalogue>(reader.ReadToEnd());
+            }
+        }
+
+        private static string Normalize(string text) {
+            return Regex.Replace((text ?? "").Replace(@"\n", "\n"), @"\s+", " ").Trim();
+        }
+
+        public static string Description(string fileName, string original) {
+            if (fileName != null && Data.Descriptions.TryGetValue(fileName, out var entry)
+                && String.Equals(Normalize(original), Normalize(entry.Source), StringComparison.Ordinal)) {
+                return entry.French;
+            }
+            // A changed publisher description must not be hidden by an outdated translation.
+            return original ?? "";
+        }
+
+        public static string Categories(string original) {
+            return String.Join(", ", (original ?? "").Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
+                .Select(t => t.Trim()).Select(t => Data.Categories.TryGetValue(t, out string french) ? french : t));
+        }
+    }
+}
